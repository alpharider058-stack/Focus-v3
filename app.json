{
  "expo": {
    "name": "Focus",
    "slug": "focus",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./Logo.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./Logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#08080C"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.focus.discipline",
      "buildNumber": "1",
      "appleTeamId": "XXXXXXXXXX",
      "icon": "./Logo.png",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.focus.discipline"
        ]
      },
      "infoPlist": {
        "NSSupportsLiveActivities": true,
        "NSSupportsLiveActivitiesFrequentUpdates": true,
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "UIUserInterfaceStyle": "Dark",
        "CFBundleDisplayName": "Focus"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#08080C",
          "image": "./Logo.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./Logo.png",
          "color": "#FF5A1F",
          "mode": "production"
        }
      ],
      "@bacons/apple-targets"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "focus-app-ios"
      }
    }
  }
}
